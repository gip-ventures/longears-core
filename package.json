{
  "name": "longears-core",
  "version": "0.1.0",
  "description": "Dependency metadata collection service — a Dependabot-like GitHub Action",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --minify",
    "compile": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/glob": "^0.6.1",
    "axios": "^1.15.0",
    "js-yaml": "^4.1.1",
    "minimatch": "^3.1.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "license": "MIT"
}
