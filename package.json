{
  "name": "longears-core",
  "version": "0.1.0",
  "description": "Dependency metadata collection service — a Dependabot-like GitHub Action",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && ncc build dist/main.js -o dist --minify",
    "compile": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.4.0",
    "axios": "^1.15.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.17",
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  },
  "license": "MIT"
}
